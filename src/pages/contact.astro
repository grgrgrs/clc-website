---
import Base from "../layouts/Base.astro";
import { site } from "../site";
---
<Base title="Contact" description="How to reach Concerned Letcher Countians.">
  <div class="prose page-head">
    <h1>Contact us</h1>

    <h2>Email</h2>
    <p><a href={`mailto:${site.email}`}>{site.email}</a></p>

    <h2>Mail</h2>
    <p>{site.legalName}<br />{site.mail[0]}<br />{site.mail[1]}</p>

    <h2>Mailing list</h2>
    <p>To get occasional updates on significant activity, email us at <a href={`mailto:${site.email}?subject=Add%20me%20to%20the%20mailing%20list`}>{site.email}</a> and ask to join the mailing list.</p>

    <p class="small-print">CLC is a nonprofit, registered with the Kentucky Secretary of State as an LLC.</p>
  </div>
</Base>
