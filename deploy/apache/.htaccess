# Apache (e.g. GreenGeeks cPanel): copy into public/ to use.
ErrorDocument 404 /404.html
RewriteEngine On
# Force HTTPS and the bare domain
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://concernedletchercountians.org%{REQUEST_URI} [L,R=301]
# Old Weebly URLs
# Only redirect when the visitor literally asked for /index.html (DirectoryIndex also uses it internally)
RewriteCond %{THE_REQUEST} \s/index\.html[\s?]
RewriteRule ^index\.html$ / [L,R=301]
RewriteRule ^news\.html$ /news/ [L,R=301]
RewriteRule ^videos\.html$ /videos/ [L,R=301]
RewriteRule ^about\.html$ /about/ [L,R=301]
RewriteRule ^contact\.html$ /contact/ [L,R=301]
RewriteRule ^clc-talking-points\.html$ /why-we-oppose/ [L,R=301]
RewriteRule ^our-letter-to-the-bop\.html$ /why-we-oppose/letter-to-bop-2024/ [L,R=301]
RewriteRule ^find-out-what-your-neighbors-are-saying\.html$ /about/ [L,R=301]
RewriteRule ^survey\.html$ / [L,R=301]
RewriteRule ^clc-comments\.html$ / [L,R=301]
RewriteRule ^more\.html$ / [L,R=301]
